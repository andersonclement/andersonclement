# ============================================
# SmartTrader 7CAS - Configuration Production
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# --- Obligatoire ---

# Cle secrete Flask (generez avec: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGEZ_MOI_avec_une_cle_aleatoire_de_64_caracteres

# Mot de passe admin (le compte 'admin' sera cree au premier lancement)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=votre_mot_de_passe_admin_securise

# Cle de chiffrement pour les identifiants trading
# Generez avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: ne changez JAMAIS cette cle apres le premier lancement,
# sinon les identifiants deja stockes seront illisibles
ENCRYPTION_KEY=

# --- Optionnel ---

# Mode (production ou development)
FLASK_ENV=production

# Port du serveur web
PORT=5000

# MetaApi token pour connexion cloud MT5
# Inscrivez-vous sur https://metaapi.cloud pour obtenir un token
METAAPI_TOKEN=

# Base de donnees (defaut: SQLite dans ./data/smarttrader.db)
# Pour PostgreSQL: postgresql://user:pass@host:5432/smarttrader
DATABASE_URL=

# Rate limiting (gere automatiquement par docker-compose avec Redis)
# Changez uniquement si vous utilisez un Redis externe
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Nom de domaine (pour le certificat SSL)
DOMAIN=smarttrader.votredomaine.com
